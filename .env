NODE_ENV=production
PORT=3030

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=realestate
DB_SSL=false
DB_SYNCHRONIZE=true

ACCESS_TOKEN_SECRET=fde3698b5f3937d6d9e2f1f8c18c0445b2138bcb42f817ca2dd1af8627a0cba5
REFRESH_TOKEN_SECRET=71e9769a379f069c185f7bf0585c89d90d39407f5e5b8d9fc018d6753f033d37

CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://your-frontend-domain.com

# ── Email Provider (priority: Postmark → Mailgun → SMTP) ───────────────────────
# Postmark (recommended): create a server at https://postmarkapp.com and copy
# the Server API Token. Postmark offers a free trial month then paid plans.
POSTMARK_SERVER_TOKEN=your-postmark-server-token
EMAIL_FROM="الوساطة الرقمية <noreply@your-domain.com>"

# Mailgun fallback (optional)
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain

# Generic SMTP fallback (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_SECURE=false

# ── Seeded Admin (used in development and to ensure an admin exists) ───────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
