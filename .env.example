NODE_ENV=production
PORT=3030

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=realestate
DB_SSL=false
DB_SYNCHRONIZE=false

ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-long-random-secret

# Nafath / Elm Rabet (server-side only; never expose APP_KEY in the frontend)
NAFATH_BASE_URL=https://rabet-nafath.api.elm.sa/nafath-sandbox
NAFATH_APP_ID=
NAFATH_APP_KEY=
NAFATH_AUDIENCE=
NAFATH_RETURN_URL=https://www.digitalbrokerage.sa/profile
NAFATH_CLIENT_IP=
NAFATH_JWK_PATH=/api/v2/oidc/jwk
NAFATH_ISSUER=https://www.iam.gov.sa/userauth

CORS_ORIGIN=https://your-frontend-domain.com

# Geidea HPP (server-side only). Use gateway TEST keys, not portal login credentials.
# Enable only after the merchant's online payment gateway is configured.
GEIDEA_ENABLED=false
GEIDEA_REGION=KSA
GEIDEA_MODE=test
GEIDEA_MERCHANT_PUBLIC_KEY=
GEIDEA_API_PASSWORD=
GEIDEA_CALLBACK_URL=https://www.digitalbrokerage.sa/api/payment/geidea/callback
GEIDEA_RETURN_URL=https://www.digitalbrokerage.sa/wallet

# ── Email Provider (priority: Postmark → Mailgun → SMTP) ───────────────────────
# Postmark (recommended): create a server at https://postmarkapp.com and copy
# the Server API Token. Postmark offers a free trial month then paid plans.
POSTMARK_SERVER_TOKEN=your-postmark-server-token
EMAIL_FROM="الوساطة الرقمية <noreply@your-domain.com>"

# Mailgun fallback (optional)
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain

# Generic SMTP fallback (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_SECURE=false

# ── Seeded Admin (used in development and to ensure an admin exists) ───────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# Trusted reverse proxy IP/subnet (optional; do not use an unrestricted trust setting)
TRUST_PROXY=

# Defaults to true; set false only for an explicitly deferred enforcement rollout
NAFATH_ENFORCE_VERIFICATION=true
